# Copy to .env and fill in real values. .env is git-ignored.

# Datadog: get API key from https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=changeme
# DD_SITE depends on your Datadog account region:
# - US1:        datadoghq.com
# - US3:        us3.datadoghq.com
# - US5:        us5.datadoghq.com
# - EU1:        datadoghq.eu
# - AP1:        ap1.datadoghq.com
DD_SITE=datadoghq.com

# JWT secret (must be >= 32 chars). Used by api-gateway and auth-service.
JWT_SECRET=please-change-me-this-must-be-32-chars-minimum
JWT_ISSUER=changee-finance
